// HB Finance - Prisma Schema
// Multi-tenant, type-safe

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ PLANOS SAAS ============
enum Plan {
  FREE
  START
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

// ============ MULTI-TENANT ============
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      TenantType @default(PERSONAL) // PERSONAL | BUSINESS
  currentPlan Plan   @default(FREE)
  stripeCustomerId String?  // Stripe Customer para cobrança
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  accounts           Account[]
  categories         Category[]
  budgets            Budget[]
  bills              Bill[]
  transactions       Transaction[]
  payees             Payee[]
  tags               Tag[]
  recurringTemplates RecurringTemplate[]
  reconciliations    Reconciliation[]
  auditLogs          AuditLog[]
  subscriptions      Subscription[]
  paymentHistories   PaymentHistory[]
  couponRedemptions  CouponRedemption[]
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  paymentHistories     PaymentHistory[]

  @@index([tenantId])
  @@index([status])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  planGranted     Plan
  expirationDate  DateTime?
  usageLimit      Int?     // null = ilimitado (cupom master)
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  createdByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@unique([couponId, tenantId])
  @@index([couponId])
  @@index([tenantId])
}

model PaymentHistory {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("BRL")
  status             String   // paid, failed, refunded
  stripeInvoiceId    String?
  stripePaymentIntentId String?
  paidAt             DateTime?
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([createdAt])
}

enum TenantType {
  PERSONAL
  BUSINESS
}

// ============ AUTH & USERS ============
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String
  phone          String?
  role           UserRole  @default(USER)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailVerified  DateTime?
  monthlyIncome  Decimal?  @db.Decimal(12, 2)
  financialGoal  String?   // controle_financeiro | guardar_dinheiro | investir | outros
  birthYear      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs              AuditLog[]

  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

// ============ CONTAS BANCÁRIAS ============
model Account {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(BANK)
  balance        Decimal   @default(0) @db.Decimal(15, 2)
  openingBalance Decimal   @default(0) @db.Decimal(15, 2)  // saldo de abertura
  openingDate    DateTime? // data do saldo de abertura
  currency       String    @default("BRL")
  isActive       Boolean   @default(true)
  bankCode       String?   // código do banco (ex. 001)
  agency         String?   // agência
  accountNumber String?   // número da conta
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions       Transaction[]
  bills              Bill[]
  reconciliations     Reconciliation[]
  recurringTemplates RecurringTemplate[]

  @@index([tenantId])
}

enum AccountType {
  BANK
  CASH
  CREDIT
  INVESTMENT
}

// ============ CATEGORIAS ============
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType // INCOME | EXPENSE
  color     String?
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  sortOrder Int      @default(0)  // ordem de exibição
  isSystem  Boolean  @default(false) // categorias padrão do sistema
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions     Transaction[]
  budgets          Budget[]
  bills            Bill[]
  recurringTemplates RecurringTemplate[]

  @@index([tenantId])
  @@index([parentId])
}

enum CategoryType {
  INCOME
  EXPENSE
}

// ============ FAVORECIDOS / BENEFICIÁRIOS ============
model Payee {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  document  String?  // CPF/CNPJ
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]

  @@index([tenantId])
  @@index([name])
}

// ============ ETIQUETAS ============
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionTags TransactionTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ============ TRANSAÇÕES ============
model Transaction {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payeeId        String?
  payee          Payee?   @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  amount         Decimal  @db.Decimal(15, 2) // positivo = entrada, negativo = saída
  type           TransactionType @default(EXPENSE)
  description    String?
  date           DateTime
  checkNumber    String?  // número do cheque
  attachmentUrl   String?  // comprovante/recibo
  isReconciled   Boolean  @default(false)
  reconciliationId String?
  reconciliation  Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  externalId     String?  // ID do banco/OFX para conciliação
  transferPairId String?  @unique // id da outra perna da transferência (1:1)
  transferPair   Transaction? @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  pairedTransfer Transaction? @relation("TransferPair")
  metadata       Json?    // dados extras (parcelas, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  billId      String?
  bill       Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  tags       TransactionTag[]

  @@index([tenantId])
  @@index([accountId])
  @@index([categoryId])
  @@index([payeeId])
  @@index([date])
  @@index([externalId])
  @@index([reconciliationId])
  @@index([tenantId, date])
}

// N:N Transação <-> Tag
model TransactionTag {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// ============ CONTAS A PAGAR / RECEBER ============
model Bill {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description  String
  amount       Decimal  @db.Decimal(15, 2)
  dueDate      DateTime
  type         BillType @default(PAYABLE)
  status       BillStatus @default(PENDING)
  recurrence   RecurrenceType? // MONTHLY, YEARLY, etc.
  totalInstallments Int?  // parcelas
  currentInstallment Int? @default(1)
  attachmentUrl String? // PDF/boleto
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]

  @@index([tenantId])
  @@index([dueDate])
  @@index([status])
  @@index([tenantId, dueDate])
}

enum BillType {
  PAYABLE
  RECEIVABLE
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum RecurrenceType {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

// ============ MODELO DE TRANSAÇÃO RECORRENTE ============
model RecurringTemplate {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payeeId      String?
  payee        Payee?        @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  description  String
  amount       Decimal       @db.Decimal(15, 2)
  type         TransactionType @default(EXPENSE)
  recurrence   RecurrenceType // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth   Int           // 1-28 (dia de execução)
  nextRunAt    DateTime      // próxima data de geração
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([nextRunAt])
}

// ============ CONCILIAÇÃO BANCÁRIA ============
model Reconciliation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startedAt      DateTime
  closedAt       DateTime?
  openingBalance Decimal  @db.Decimal(15, 2)
  closingBalance Decimal? @db.Decimal(15, 2)
  status         ReconciliationStatus @default(OPEN)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]

  @@index([tenantId])
  @@index([accountId])
  @@index([status])
}

enum ReconciliationStatus {
  OPEN
  CLOSED
}

model Budget {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(15, 2)
  period     String   // "2025-01" (month)
  alertThreshold Decimal? @db.Decimal(5, 2) // % para alerta (ex: 80)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, categoryId, period])
  @@index([tenantId])
  @@index([period])
}

// ============ NOTIFICAÇÕES ============
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?  @db.Text
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  metadata  Json?
  sentAt    DateTime? // quando foi enviada por canal externo (WhatsApp/Email)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

// Preferências por usuário: quais eventos e por qual canal (WhatsApp/Email)
model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     NotificationChannel // WHATSAPP | EMAIL
  enabled     Boolean  @default(true)
  eventTypes  Json     // ["BILL_DUE", "BILL_OVERDUE", ...]
  dailyTime   String?  // "08:00" para horário do lembrete diário
  weeklyDay   Int?     // 0-6 para resumo semanal (0=domingo)
  monthlyDay  Int?     // 1-28 para resumo mensal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, channel])
  @@index([userId])
}

enum NotificationType {
  BILL_DUE
  BILL_OVERDUE
  RECEIVABLE_DUE
  RECEIVABLE_RECEIVED
  EXPENSE_REGISTERED
  BUDGET_ALERT
  BURN_RATE
  LOW_BALANCE
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
  AI_TIP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

// ============ AUDITORIA ============
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // "transaction.delete", "bill.update", etc.
  entityType String   // Transaction, Bill, User...
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
