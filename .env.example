# ============ HB Finance - Variáveis de ambiente ============
# Copie para .env e preencha os valores.

# ---------- Banco de dados (PostgreSQL / Supabase) ----------
# Supabase: substitua [YOUR-PASSWORD] pela senha do banco (Dashboard > Project Settings > Database)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.qgwcmzpjsxqpbzuphhre.supabase.co:5432/postgres"

# ---------- Supabase (opcional; para Auth, Realtime, Storage) ----------
# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Redis (BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# ---------- Auth0 (login social / JWT) ----------
# Usado pelo @auth0/nextjs-auth0. No Dashboard Auth0 configure:
# - Allowed Callback URLs: ${APP_BASE_URL}/api/auth0/callback
# - Allowed Logout URLs: ${APP_BASE_URL} ou ${APP_BASE_URL}/app/dashboard
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=dev-zppcwdlh1zc5p8o7.us.auth0.com
AUTH0_CLIENT_ID=B91rd56WNq5FTPyA7tNOyos4hqGGZ0H7
AUTH0_CLIENT_SECRET=LILzw_m8rtgzg730CSvW-QrwuEjisw3HpzPiSXid3DjeX93l3I4HfAIvVu36y91I

AUTH0_SECRET=49ec9fab87ec1e579c4a70b797b083b31f1116afeda50bb87b5ad859d214bf88


# ---------- AI Advisor (OpenAI) ----------
OPENAI_API_KEY=

