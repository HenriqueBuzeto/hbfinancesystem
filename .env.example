# ---------- Stripe (pagamentos / assinaturas SaaS) ----------
# Chave secreta: apenas no backend; nunca commitar nem expor no frontend.
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Chave publicável: pode ser usada no frontend (Stripe.js / checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Modo teste: um único Price ID para ambos os planos (opcional)
STRIPE_PRICE_ID_TEST=price_xxx
# Product IDs (prod_xxx) - assinatura usa R$ 19,90/mês (Start) e R$ 49,90/mês (Pro)
STRIPE_PRODUCT_ID_START=prod_xxx
STRIPE_PRODUCT_ID_PRO=prod_xxx
# Ou use Price IDs (price_xxx) em vez de Product IDs
STRIPE_PRICE_ID_START=price_xxx
STRIPE_PRICE_ID_PRO=price_xxx
# Webhook: assinatura para validar eventos (Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Portal do cliente: URL para o usuário gerenciar assinatura (gerada via API ao criar sessão).
# STRIPE_CUSTOMER_PORTAL_URL=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
